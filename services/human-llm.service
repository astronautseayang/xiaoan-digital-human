[Unit]
Description=Digital human local Qwen LLM
After=network.target
[Service]
WorkingDirectory=/home/yyy/digital-human
ExecStart=/home/yyy/digital-human/llama.cpp/build/bin/llama-server -m /home/yyy/digital-human/models/llm/qwen2.5-3b-instruct-q4_k_m.gguf --host 127.0.0.1 --port 8080 -c 8192 -t 6 --alias local-qwen
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/yyy/digital-human/logs/llm.log
StandardError=append:/home/yyy/digital-human/logs/llm.log
[Install]
WantedBy=default.target
